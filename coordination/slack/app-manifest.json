{
  "display_information": {
    "name": "Diretor — Produto",
    "description": "Assistente de IA que comunica marcos do Produto Ganesha ao time.",
    "background_color": "#6C3BEE"
  },
  "features": {
    "bot_user": {
      "display_name": "diretor-produto",
      "always_online": false
    }
  },
  "oauth_config": {
