BOT_USERNAME=Ganesha
SLACK_CONNECTOR=slack/ganesha
# Required: only this Slack workspace may invoke the bot.
SLACK_TEAM_ID=
SLACK_APP_ID=
SLACK_BOT_USER_ID=
SLACK_DEVOPS_CHANNEL_ID=
SLACK_LANDING_PAGES_CHANNEL_ID=
# Enable only after both app identities are installed and verified.
SLACK_DEDICATED_IDENTITIES=false
SLACK_DEVOPS_CONNECTOR=slack/ganesha
SLACK_DEVOPS_APP_ID=
SLACK_DEVOPS_BOT_USER_ID=
SLACK_LANDING_PAGES_CONNECTOR=slack/glandingpage
SLACK_LANDING_PAGES_APP_ID=
SLACK_LANDING_PAGES_BOT_USER_ID=
# Owner policy: any verified bot in this workspace may explicitly mention an agent.
SLACK_ALLOW_WORKSPACE_BOTS=false

# Explicit model backend; local-codex queues work until the owner's PC is available.
GENERATION_BACKEND=gateway
# Random 32-byte bearer secret, shared only with the outbound local worker.
LOCAL_WORKER_TOKEN=
# Explicitly approved external bot users; only mentioned Landing Pages briefs.
SLACK_ALLOWED_AGENT_USER_IDS=
REDIS_URL=
PUBLIC_BASE_URL=https://ganesha-devops.vercel.app
# Vercel injects VERCEL_OIDC_TOKEN for Connect and AI Gateway.
# Local development: vercel env pull .env.local
AI_MODEL=openai/gpt-5-nano
LANDING_AI_MODEL=openai/gpt-5-nano
# Per-day model request limit across the whole workspace (UTC).
DAILY_REQUEST_LIMIT=40
